# EST Karaoke environment template
# Fill these in Railway. DO NOT commit real secret values.

PORT=3000

# Admin / game sync
ADMIN_PASSWORD=
GAME_SYNC_TOKEN=

# Roblox Open Cloud uploader profile(s)
# Keep the same variable names your current Railway project already uses.
# Do not paste real keys into GitHub.

# Optional upload limits
MAX_UPLOAD_MB=200
MAX_VIDEO_UPLOAD_MB=750
VIDEO_UPLOAD_MAX_DURATION_SECONDS=1200
YOUTUBE_MAX_DURATION_SECONDS=900

# Demucs / video analysis defaults
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
DEMUCS_SEGMENT=7
VIDEO_SYNC_SAMPLE_FPS=8
VIDEO_SYNC_MAX_SECONDS=240

# Optional YouTube authentication for Railway datacenter challenges.
# Store only in Railway Variables, never in GitHub.
YOUTUBE_COOKIES_B64=

# Optional original-reference enhanced synchronization
REFERENCE_SYNC_FPS=4
REFERENCE_SYNC_MAX_OFFSET_SECONDS=90
REFERENCE_SYNC_TIMEOUT_MINUTES=20
YOUTUBE_REFERENCE_MAX_DURATION_SECONDS=900


# ============================================================
# DURABLE KTV LIBRARY STORAGE
# ============================================================
# Strongly recommended: use an EXTERNAL PostgreSQL provider
# (for example Supabase, Neon, or another provider outside Railway).
#
# This keeps songs/lyrics/Roblox asset IDs safe even if the Railway
# service or whole Railway project is removed.
#
# DO NOT put the real URL/password in GitHub. Put it in Railway Variables.
EST_DATABASE_URL=

# When true, EST refuses to start without the external DB rather than
# accidentally falling back to temporary Railway filesystem storage.
EST_DATABASE_REQUIRED=true

# Number of historical automatic KTV library snapshots kept in Postgres.
EST_LIBRARY_SNAPSHOTS=250
